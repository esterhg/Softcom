# Django Configuration
DJANGO_DEBUG=False
SECRET_KEY=your-secret-key-here-change-in-production
ALLOWED_HOSTS=*

# Database Configuration
# Formato: postgresql://usuario:contraseña@host:puerto/nombre_bd
DATABASE_URL=postgresql://postgres:password@db_host:5432/energia_db

# Celery Configuration (para producción con docker-compose)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=django-db

# Configuración adicional (opcional)
# PORT=8000
# DJANGO_SETTINGS_MODULE=energia.settings

# Dynamics 365 Configuration
DYNAMICS_TENANT_ID=your-tenant-id
DYNAMICS_CLIENT_ID=your-client-id
DYNAMICS_CLIENT_SECRET=your-client-secret
DYNAMICS_RESOURCE_URL=https://your-org.crm.dynamics.com

# n8n Integration Configuration
# IMPORTANTE: En producción, usar URLs internas de Coolify (nombres de servicio)
# En local, usar IPs públicas o localhost

# URL base del sitio (para callbacks de n8n a Django)
# Local: http://localhost:8000
# Producción: https://softcom.ccg.hn o http://django:8000 (interno)
SITE_URL=https://softcom.ccg.hn

# Webhook de n8n para notificar nuevo documento
# Local: http://181.115.47.107:5678/webhook/nuevo-documento
# Producción: http://n8n:5678/webhook/nuevo-documento (nombre del servicio en Coolify)
N8N_WEBHOOK_URL=http://n8n:5678/webhook/nuevo-documento

# Webhook de n8n para chat con IA
# Local: http://181.115.47.107:5678/webhook/chat-documento
# Producción: http://n8n:5678/webhook/chat-documento
N8N_CHAT_WEBHOOK_URL=http://n8n:5678/webhook/chat-documento

# Webhook de n8n para extracción de texto de PDFs
# Local: http://181.115.47.107:5678/webhook-test/extract-text
# Producción: http://n8n:5678/webhook-test/extract-text
N8N_EXTRACT_TEXTO_WEBHOOK_URL=http://n8n:5678/webhook-test/extract-text

# ── Configuración de Email SMTP ─────────────────────────────────────────────
# Si EMAIL_HOST NO está definido, Django imprime correos en consola (modo desarrollo).
# En producción, completar todos los campos.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=notificaciones@empresa.com
EMAIL_HOST_PASSWORD=tu-contraseña-smtp
DEFAULT_FROM_EMAIL=notificaciones@empresa.com

# Email(s) del equipo de Procura (separados por coma si son varios).
# Se usa para notificar cuando una requisición es aprobada.
# Si el grupo "Procura" en Django ya tiene usuarios con email, esto es opcional.
PROCURA_EMAIL=procura@empresa.com
